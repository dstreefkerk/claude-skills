{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/microsoft/sentinel-connectors/ccf-schema/log-analytics-table.schema.json",
    "title": "Azure Log Analytics Custom Table",
    "description": "Schema for Azure Log Analytics custom tables used in Microsoft Sentinel Codeless Connector Framework",
    "type": "object",
    "required": ["name", "type", "apiVersion", "properties"],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "description": "The unique identifier name for the Log Analytics table.",
            "minLength": 4,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9-_]+$",
            "examples": ["ContosoEvents_CL", "AcmeSecurityAlerts_CL", "DataGuardAuditLogs_CL"]
        },
        "type": {
            "type": "string",
            "description": "The resource type",
            "const": "Microsoft.OperationalInsights/workspaces/tables"
        },
        "apiVersion": {
            "type": "string",
            "description": "The API version for the Log Analytics Tables REST API",
            "enum": ["2021-03-01-privatepreview", "2021-12-01-preview", "2022-10-01", "2023-09-01", "2025-02-01"],
            "default": "2025-02-01"
        },
        "location": {
            "type": "string",
            "description": "Azure region location for the table resource.",
            "default": "{{location}}"
        },
        "tags": {
            "type": "object",
            "description": "Resource tags for organizing and managing tables within Azure.",
            "additionalProperties": {
                "type": "string"
            },
            "examples": [
                "{\"connector\": \"ContosoSecurity\", \"dataType\": \"Events\", \"version\": \"1.0\"}",
                "{\"environment\": \"production\", \"owner\": \"SecurityTeam\"}",
                "{\"costCenter\": \"IT-Security\", \"application\": \"SIEM\"}"
            ]
        },
        "properties": {
            "type": "object",
            "required": ["schema"],
            "additionalProperties": false,
            "properties": {
                "plan": {
                    "type": "string",
                    "description": "The pricing plan for the table that determines query capabilities and cost structure.",
                    "enum": ["Analytics", "Basic", "Auxiliary"],
                    "examples": ["Analytics"]
                },
                "retentionInDays": {
                    "type": "integer",
                    "description": "The number of days data is retained in active (queryable) storage.",
                    "minimum": 4,
                    "maximum": 730,
                    "examples": ["90", "180", "365"]
                },
                "totalRetentionInDays": {
                    "type": "integer",
                    "description": "Total data retention period including both active and archived storage.",
                    "minimum": 4,
                    "maximum": 4383,
                    "examples": ["1095", "1825", "2555"]
                },
                "restoredLogs": {
                    "type": "object",
                    "description": "Configuration for restored log data from archived storage",
                    "additionalProperties": false,
                    "properties": {
                        "startRestoreTime": {
                            "type": "string",
                            "description": "Start time for the restore operation (ISO 8601 format)"
                        },
                        "endRestoreTime": {
                            "type": "string",
                            "description": "End time for the restore operation (ISO 8601 format)"
                        },
                        "sourceTable": {
                            "type": "string",
                            "description": "Source table name from which to restore data"
                        }
                    }
                },
                "searchResults": {
                    "type": "object",
                    "description": "Configuration for search results table",
                    "additionalProperties": false,
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "KQL query to execute for search results"
                        },
                        "description": {
                            "type": "string",
                            "description": "Description of the search results table"
                        },
                        "limit": {
                            "type": "integer",
                            "description": "Maximum number of results to return"
                        },
                        "startSearchTime": {
                            "type": "string",
                            "description": "Start time for the search query (ISO 8601 format)"
                        },
                        "endSearchTime": {
                            "type": "string",
                            "description": "End time for the search query (ISO 8601 format)"
                        }
                    }
                },
                "schema": {
                    "type": "object",
                    "required": ["name", "columns"],
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "The schema name, typically matching the table name.",
                            "examples": ["ContosoEvents_CL", "AcmeSecurityAlerts_CL", "DataGuardAuditLogs_CL"]
                        },
                        "displayName": {
                            "type": "string",
                            "description": "Display name for the schema in the Log Analytics workspace"
                        },
                        "description": {
                            "type": "string",
                            "description": "Human-readable description of the table schema and its purpose.",
                            "examples": [
                                "Security events from Contoso API including authentication and authorization logs",
                                "Alert data collected from Acme Security platform",
                                "Audit logs from DataGuard compliance system"
                            ]
                        },
                        "columns": {
                            "type": "array",
                            "description": "Array of column definitions that define the table structure and data types.",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/tableColumn"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "tableColumn": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The unique identifier name for a column within the table.",
                    "maxLength": 45,
                    "examples": ["TimeGenerated", "EventType", "SourceIPAddress", "UserPrincipalName", "Severity"]
                },
                "displayName": {
                    "type": "string",
                    "description": "Display name for the column in the Log Analytics workspace"
                },
                "type": {
                    "type": "string",
                    "description": "The data type for the column that determines storage format and query capabilities.",
                    "enum": ["string", "int", "long", "real", "boolean", "datetime", "dynamic", "guid", "timespan"],
                    "examples": ["datetime", "string", "long", "dynamic"]
                },
                "dataTypeHint": {
                    "type": "string",
                    "description": "Hint about the semantic meaning of the data type for better query optimization",
                    "enum": ["uri", "guid", "armPath", "ip"]
                },
                "description": {
                    "type": "string",
                    "description": "Human-readable description explaining the column's purpose and content.",
                    "examples": [
                        "Timestamp when the event was generated by the source system",
                        "Type of security event (login, logout, file access, etc.)",
                        "IP address of the source system or user",
                        "Severity level of the event (Low, Medium, High, Critical)"
                    ]
                },
                "isDefaultDisplay": {
                    "type": "boolean",
                    "description": "Controls whether this column appears in default query results when users view the table.",
                    "examples": ["true", "false"]
                },
                "isHidden": {
                    "type": "boolean",
                    "description": "Controls whether this column is hidden from schema views in the Log Analytics workspace.",
                    "examples": ["true", "false"]
                }
            }
        }
    }
}
